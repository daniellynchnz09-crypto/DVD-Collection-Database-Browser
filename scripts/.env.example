# Copy to .env (already gitignored) and fill in.
# See Claude/TECH STACK AND ARCHITECTURE.md's "Google Sheet Sync" section.

GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key from the service account JSON, keeping the \n escape sequences.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE="All DVDs and Specs!A1:AF5000"

# Service role key, NOT the anon key - this script deliberately bypasses RLS.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Needed by resolve-pending-scans.ts (Phase 1 barcode scanning).
OMDB_API_KEY=

# Needed by keep-alive.ts. It only reads (titles' RLS allows public select), so it
# uses the anon key for BOTH projects rather than the service-role key above - no
# reason to hand a scheduled CI job more power than the task needs. Leave either
# project's pair blank to only ping the other one. See Claude/TECH STACK AND
# ARCHITECTURE.md's "Hosting / Keep-Alive" section.
SUPABASE_ANON_KEY=
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
