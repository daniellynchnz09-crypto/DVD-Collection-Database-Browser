# Copy to .env (already gitignored) and fill in.
# See Claude/TECH STACK AND ARCHITECTURE.md's "Google Sheet Sync" section.

GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key from the service account JSON, keeping the \n escape sequences.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE="All DVDs and Specs!A1:AF5000"

# Service role key, NOT the anon key - this script deliberately bypasses RLS.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Needed by resolve-pending-scans.ts (Phase 1 barcode scanning).
OMDB_API_KEY=

# Needed by keep-alive.ts to also ping the PUBLIC Supabase project (anon key is fine -
# it only does a read against a public-read table). Leave blank to only ping the
# private project above. See Claude/TECH STACK AND ARCHITECTURE.md's "Hosting" section.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
