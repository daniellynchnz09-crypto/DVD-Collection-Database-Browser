# Copy to .env (already gitignored) and fill in. Expo only exposes vars prefixed
# EXPO_PUBLIC_ to app code - see https://docs.expo.dev/guides/environment-variables/

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Your computer's LAN IP (not localhost/127.0.0.1) while testing on a phone over Wi-Fi,
# or the deployed Vercel URL once apps/web is deployed.
EXPO_PUBLIC_SCAN_API_URL=http://192.168.1.x:3000
# Same value as apps/web/.env.local's SCAN_API_SECRET.
EXPO_PUBLIC_SCAN_API_SECRET=
