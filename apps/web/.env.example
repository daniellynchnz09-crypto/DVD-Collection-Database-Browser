# Copy to .env.local (already gitignored) and fill in.
# For the PRIVATE build, use your private Supabase project.
# For the sanitized PUBLIC build (see scripts/src/sanitize-public-repo.ts), use the public project.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OMDB API key (RESOURCES.md: prioritized over IMDB since it has a public API).
OMDB_API_KEY=

# TMDb (themoviedb.org) - per-title NZ/Oceania rating certification + primary production
# company, since IMDb itself prohibits automated scraping and OMDB's own Rated/Production
# fields don't reliably cover either. TMDB_READ_ACCESS_TOKEN (v4 bearer token) is what's
# actually used. See Claude/TECH STACK AND ARCHITECTURE.md's TMDb section.
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=

# Phase 1 (barcode scanning) - server-only secrets, never exposed to the browser/app bundle.
# See Claude/TECH STACK AND ARCHITECTURE.md's "BARCODE SCANNING PIPELINE" section.
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE="Sheet1!A1:AF5000"
# Shared-secret header the mobile app must send (x-scan-secret) - generate with
# `node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"`.
SCAN_API_SECRET=
